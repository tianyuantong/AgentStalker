# Auto-generated by AgentStalker
# 用法: 渲染后与 sandbox/docker-compose.test.yml 配合使用（docker compose -f docker-compose.test.yml -f docker-compose.override.yml up）

version: "3.9"

services:
  agent-under-test:
    build:
      context: {{ source_dir }}
      dockerfile: {{ dockerfile_path }}
    environment:
      AGENT_FRAMEWORK: {{ framework }}
      AGENT_LANGUAGE: {{ language }}
      AGENT_PORT: "{{ port }}"
      # LLM 调用走 LiteLLM 代理（强制）
      OPENAI_API_BASE: http://llm-proxy:4000
      ANTHROPIC_API_BASE: http://llm-proxy:4000
      # 外部依赖指向 mock 服务
      DATABASE_URL: postgres://testuser:testpass@mock-db:5432/testdb
      SMTP_HOST: mock-mail
      SMTP_PORT: "1025"
      EXTERNAL_API_URL: http://mock-api:8080
      AGENT_MODE: audit
    networks:
      - agent-net
    # 沙箱内可写临时文件
    tmpfs:
      - /tmp:size=100M,noexec
    read_only: false

  # eBPF 监控（确保特权）
  ebpf-monitor:
    privileged: true
    cap_add:
      - SYS_ADMIN
      - SYS_PTRACE
    pid: host

  # 注入用户提供的环境变量（如 OPENAI_API_KEY）
  {% for key, value in env_vars.items() %}
  x-extra-env: &env-{{ key }} {{ key }}={{ value }}
  {% endfor %}

networks:
  agent-net:
    driver: bridge
    # 不主动连外网；外部 HTTP 走 mock-api 或显式 allowlist
    internal: false
