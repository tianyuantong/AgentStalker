# AgentStalker 反向代理（jinja2 模板）
# Render with: jinja2 nginx.conf.j2 -D target_port=8000 -D session_header="X-Session-Id"
worker_processes 1;
events {
    worker_connections 1024;
}

http {
    log_format ast_log escape=json
        '{'
            '"ts":"$time_iso8601",'
            '"client":"$remote_addr",'
            '"method":"$request_method",'
            '"uri":"$request_uri",'
            '"status":$status,'
            '"req_body":$request_body,'
            '"resp_body":$resp_body_capture,'
            '"ua":"$http_user_agent",'
            '"session":"$http_{{ session_header | default("x-session-id") | lower | replace("-", "_") }}"'
        '}';

    access_log /var/log/nginx/access.log ast_log buffer=32k flush=5s;
    error_log  /var/log/nginx/error.log warn;

    lua_need_request_body on;
    set $resp_body_capture "";

    body_filter_by_lua_block {
        local resp_body = ngx.arg[1]
        ngx.var.resp_body_capture = resp_body
    }

    upstream agent_upstream {
        server agent-under-test:{{ target_port }};
        keepalive 16;
    }

    server {
        listen {{ listen_port | default(8000) }};

        location /chat {
            proxy_pass http://agent_upstream/chat;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header {{ session_header | default("X-Session-Id") }} $http_{{ session_header | default("x-session-id") | lower | replace("-", "_") }};
            proxy_buffering off;
            proxy_read_timeout 120s;
        }

        location /tools/ {
            proxy_pass http://agent_upstream/tools/;
            proxy_set_header Host $host;
        }

        location /health {
            proxy_pass http://agent_upstream/health;
        }

        # 阻断沙箱内不允许的路径
        location ~ ^/(admin|internal|debug) {
            return 403;
        }
    }
}
