FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 基础工具
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates tini curl \
    && rm -rf /var/lib/apt/lists/*

# 非 root 用户
RUN useradd -m -u 1000 -s /bin/bash agentuser

WORKDIR /home/agentuser/app

# === deps 层（缓存友好）===
FROM base AS deps
COPY {{ deps_file }} .
RUN pip install -r {{ deps_file }}

# === 运行层 ===
FROM base AS runtime
COPY --from=deps /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin
COPY --chown=agentuser:agentuser . .

USER agentuser

# 默认入口（compose 可覆盖）
ENV AGENT_PORT={{ port }} \
    AGENT_ENTRYPOINT="{{ entry_command }}"

EXPOSE {{ port }}

HEALTHCHECK --interval=10s --timeout=3s --retries=3 --start-period=20s \
    CMD curl -fsS http://localhost:{{ port }}{{ health_path }} || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "exec $AGENT_ENTRYPOINT"]
