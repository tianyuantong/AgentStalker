# ============================================================
# Stage 1: Builder (full Rust toolchain)
# ============================================================
FROM rust:1.88-slim-bookworm AS builder

ENV CARGO_HOME=/usr/local/cargo \
    CARGO_TARGET_DIR=/tmp/target \
    RUST_BACKTRACE=1 \
    RUSTFLAGS="-C link-arg=-Wl,--as-needed"

# 构建依赖: cc / pkg-config / openssl / dbus headers
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libssl-dev \
        libdbus-1-dev \
        libgtk-3-dev \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# 缓存层: 复制 manifest 文件, 先做依赖 build
COPY Cargo.toml Cargo.lock ./
{% if workspace_member %}
COPY {{ workspace_member }}/Cargo.toml {{ workspace_member }}/Cargo.toml
{% endif %}
# 预 build 依赖 (避免源码变动触发依赖重新编译)
RUN mkdir -p src && echo "fn main(){}" > src/main.rs \
    && cargo fetch \
    && cargo build --release --bin dummy || true

# 复制真实源码
COPY . .
RUN rm -f src/main.rs && touch src/main.rs
RUN cargo build --release{% if features %} --features {{ features }}{% endif %}{% for bin in binaries %} --bin {{ bin }}{% endfor %}

# ============================================================
# Stage 2: Runtime (slim Debian + minimal libs)
# ============================================================
FROM debian:bookworm-slim AS runtime

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    RUST_BACKTRACE=1

# 基础工具 + 运行时库 (动态安装, 仅包含 discovery.py 列出的库)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        tini \
        curl \
        {%- for lib in required_libs %}
        {{ lib }}{%- if not loop.last %} \{% endif %}
        {%- endfor %}
    && rm -rf /var/lib/apt/lists/*

# 非 root 用户
RUN useradd -m -u 1000 -s /bin/bash agentuser

WORKDIR /home/agentuser/app

# 复制构建产物 (所有 binary)
COPY --from=builder --chown=agentuser:agentuser \
    /tmp/target/release/{% for bin in binaries %}{{ bin }}{% if not loop.last %} {% endif %}{% endfor %} \
    /home/agentuser/app/bin/

ENV PATH="/home/agentuser/app/bin:${PATH}"

USER agentuser

# 默认入口 (compose 可覆盖)
ENV AGENT_BINARY={{ primary_binary }} \
    AGENT_LANGUAGE=rust \
    AGENT_FRAMEWORK={{ framework }}

EXPOSE {{ port }}

HEALTHCHECK --interval=10s --timeout=3s --retries=3 --start-period=20s \
    CMD curl -fsS http://localhost:{{ port }}{{ health_path }} || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "exec $AGENT_BINARY {{ cli_args | default('') }}"]